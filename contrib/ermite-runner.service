# SPDX-License-Identifier: MIT
#
# systemd unit of the ermite runner. Install the static binary as
# /usr/local/bin/ermite-runner, write the settings to /etc/ermite-runner/env
# (mode 0600) and register the runner once; the README has the commands.
#
# The runner runs as root: it creates TAP devices and nftables rules (vm), loop
# mounts and containers (container), and starts the jailer. Jobs never run as
# root on the host: they run in a micro-VM or a container as user "runner".
#
# The sandboxing below is what can be added without breaking those jobs.
# What is deliberately NOT set, and why, is listed at the end of the file and
# in the README.
[Unit]
Description=ermite CI runner
Documentation=https://git.bnema.dev/bnema/ermite-runner
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
EnvironmentFile=/etc/ermite-runner/env
ExecStart=/usr/local/bin/ermite-runner run
Restart=on-failure
RestartSec=5

# SIGTERM cancels the running jobs with runner_shutdown, reports them and removes
# their sandboxes. With the defaults that takes at most 90 s (30 s for the
# executor to stop its steps, 30 s to destroy the sandbox, 30 s to report; the
# jobs do this in parallel). A test checks that this value leaves 15 s of margin
# over host.Timing.ShutdownBudget.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=120

# The state directory holds the runner token (0600), the VM images and the
# per-job files; RuntimeDirectory is for the lock and sockets.
StateDirectory=ermite-runner
StateDirectoryMode=0700
RuntimeDirectory=ermite-runner
UMask=0077

# Jobs are many processes.
TasksMax=infinity
LimitNOFILE=1048576

# ---- sandboxing that keeps loop mounts, TAP, nftables, KVM and the jailer ----
NoNewPrivileges=yes
# Nobody else's files, and no interactive logins' data.
ProtectHome=yes
# A private /tmp: the runner and the jailer do not share files with the host
# through it (the sandbox directories live in the state directory).
PrivateTmp=yes
# The runner does not set the clock, load modules or change kernel logging.
ProtectClock=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
# No setuid/setgid files created by the runner or its children.
RestrictSUIDSGID=yes
# Kernel tunables stay read-only for the unit... except where the runner needs
# them: see the end of the file (net.ipv4.ip_forward, cgroups).
LockPersonality=yes
# The runner does not need real-time scheduling.
RestrictRealtime=yes
# Syscall architectures: native only.
SystemCallArchitectures=native
# Address families the runner and its children use: Unix sockets (Docker, the
# executor stream), IPv4/IPv6 (the server, the DNS forwarder), netlink (ip, nft,
# TAP devices), packet (none needed: left out), vsock (the executor stream in a
# micro-VM).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_VSOCK

[Install]
WantedBy=multi-user.target

# ---- deliberately absent -----------------------------------------------------
#
# Delegate=yes        The runner does not manage cgroups of its own. The jailer
#                     creates the cgroups of the VMs below /sys/fs/cgroup itself
#                     (it is root and writes there directly), and Docker has its
#                     own. Delegation would hand a subtree to this unit that
#                     nothing uses.
# ProtectSystem=      The runner writes to the state directory, /run, /sys/fs/cgroup,
#                     /dev (mounts, TAP, loop devices), and Docker's data: a
#                     read-only /usr is possible but would be the only gain, and
#                     it breaks `ip`/`nft` helpers found by PATH on some distros.
# PrivateDevices=     The runner needs /dev/kvm, /dev/net/tun, /dev/loop*.
# PrivateNetwork=, RestrictNamespaces=, ProtectKernelTunables=,
# CapabilityBoundingSet=, MemoryDenyWriteExecute=, SystemCallFilter=
#                     The runner creates network namespaces and devices (TAP,
#                     veth, bridges) and mounts file systems, enables
#                     net.ipv4.ip_forward, hands capabilities to the jailer and
#                     to Docker, and starts Firecracker (which maps guest memory
#                     writable and executable). Each of these would break a path
#                     that cannot be tested without a rootful host; the
#                     boundary of a job is the micro-VM or the container, not
#                     this unit.
# ProtectControlGroups=  The jailer writes the cgroups of the VMs.
